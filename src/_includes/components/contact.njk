{% from "components/social.njk" import social as socialItem %}

<section class="contact-background" id="contact">
  <div class="heading contact">
    <h2 class="text--xl font--heading font--bold head">Get in touch!</h2>
    <p class="text--md subhead">
      I always make time for my fans. I can be reached through any of the
      following channels.
    </p>
    <ul class="socials">
      {% for item in social %}
        {{ socialItem(item) }}
      {% endfor %}
    </ul>
  </div>
</section>
