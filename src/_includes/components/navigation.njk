{% set sections = ["about", "contact"] %}

<nav class="navigation">
  <ul class="links" data-animate>
    {% for section in sections %}
      <li class="link">
        <a class="text--lg color--primary nav-link" href="#{{ section }}">
          {{- section -}}
        </a>
      </li>
    {% endfor %}
  </ul>
</nav>
