{
  "name": "website-source",
  "version": "3.0.0",
  "description": "Source code for my personal website",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "echo 'Write some tests'",
    "start": "npm run dev",
    "dev": "npm run build:css && npm-run-all --parallel dev:*",
    "dev:eleventy": "eleventy --serve --watch",
    "dev:css": "sass --watch src/assets/styles/main.scss:_site/assets/styles/main.css",
    "build": "npm run build:css && eleventy",
    "build:css": "sass src/assets/styles/main.scss:_site/assets/styles/main.css --style=compressed",
    "clean": "rm -rf _site",
    "lint:check": "prettier --check 'src/**/*.{js,json}'",
    "format": "prettier --write 'src/**/*.{js,json}'",
    "publish": "npm run build && npm run sync:dist && npm run sync:cgi",
    "sync:dist": "rsync -qa --del --exclude='*JUNK.js' --exclude='*.DS_Store' ./_site/ ../website-output",
    "sync:cgi": "rsync -qp --chmod=a+x ./build.cgi ../website-output"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CalebBurton/website-source.git"
  },
  "keywords": [],
  "author": "",
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/CalebBurton/website-source/issues"
  },
  "homepage": "https://github.com/CalebBurton/website-source#readme",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.0",
    "sass": "^1.97.2"
  }
}
